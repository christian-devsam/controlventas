# Copiá este archivo como .env.local y completá los valores.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://jjemflwxwmxgkfgelfed.supabase.co

# Llave "service_role" (NO la anon).
#
# Ojo: esta llave pasa por encima de RLS, o sea que puede todo en la base.
# Es segura acá porque NO lleva el prefijo NEXT_PUBLIC_, y por eso Next nunca
# la incluye en el código que se manda al navegador. Sólo la usa el servidor.
#
# Nunca la pegues en un componente con "use client", ni la mandes por chat,
# ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso -----------------------------------------------------------------
# El PIN que escribe Camila. 4 dígitos.
# No uses 1234, ni el año, ni la fecha de cumpleaños.
APP_PIN=

# Secreto con el que se firma la cookie de sesión. Mínimo 32 caracteres.
# Generá uno al azar (NO lo inventes a mano):
#   openssl rand -base64 32
# Si lo cambiás, todos los teléfonos vuelven a pedir el PIN.
SESION_SECRETO=
