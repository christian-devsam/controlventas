# Copiá este archivo como .env.local y completá los valores.
# Los encontrás en Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://jjemflwxwmxgkfgelfed.supabase.co

# "anon public" key. Es segura de exponer en el navegador PORQUE las tablas
# tienen RLS activo: sin sesión válida no devuelve ni una fila.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio, para que el magic link del login vuelva al lugar correcto.
# En local: http://localhost:3000 — en Vercel: https://tu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
